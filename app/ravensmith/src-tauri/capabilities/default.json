{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Baseline Ravensmith grants (rerw sidecar + file dialog)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/rerw", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/rerw", "sidecar": true }]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [{ "name": "binaries/rerw", "sidecar": true }]
    }
  ]
}
